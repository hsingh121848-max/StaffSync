# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For local MongoDB Community Server: mongodb://127.0.0.1:27017/staffsync
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/staffsync?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/staffsync
MONGO_URI=mongodb://127.0.0.1:27017/staffsync

# JSON Web Token Secret
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=30d

# Client Application URL (CORS Origin)
CLIENT_URL=http://localhost:3000
